{
  "name": "enochclock-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "An Enoch-driven clock, calendar and compass: a static site that calculates in the browser.",
  "license": "AGPL-3.0-or-later",
  "repository": "github:ztwoi/enochclock-webapp",
  "type": "module",
  "scripts": {
    "fetch-ephe": "node scripts/fetch-ephe.mjs",
    "stage": "node scripts/fetch-ephe.mjs && node scripts/stage-legal.mjs && node scripts/stage-calculator.mjs",
    "dev": "npm run stage && vite --host 127.0.0.1",
    "build": "npm run stage && tsc --noEmit && vite build && node scripts/stage-pwa.mjs",
    "build:site": "VITE_SOURCE_URL=https://github.com/ztwoi/enochclock-webapp VITE_FEEDBACK=1 npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "video": "node scripts/day-video.mjs"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "sweph-wasm": "2.6.9",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/three": "0.180.0",
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
