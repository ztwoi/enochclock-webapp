# Copy to .env to change compose defaults.

# Address the site binds to. 127.0.0.1 keeps it on this machine; 0.0.0.0 makes it reachable from other devices on your network.
ENOCH_BIND=127.0.0.1

# Where the app's "Source" link points (AGPL-3.0 requires offering the source to users of a hosted copy).
VITE_SOURCE_URL=https://github.com/ztwoi/enochclock-webapp

# Show a Feedback link in the app. Set only where the site serves POST /api/feedback (it takes a JSON {message, email?, context, website}).
# VITE_FEEDBACK=1
